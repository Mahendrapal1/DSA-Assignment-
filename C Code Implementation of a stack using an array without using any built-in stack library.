
#include <stdio.h>
#include <stdbool.h>

#define CAPACITY 5

int stack[CAPACITY];
int top = -1;

// Check if stack is empty (Underflow condition)
bool isEmpty() {
    return top == -1;
}

// Check if stack is full (Overflow condition)
bool isFull() {
    return top == CAPACITY - 1;
}

// PUSH operation
void push(int x) {
    if (isFull()) {
        printf("Stack Overflow! Cannot push %d\n", x);
    } else {
        top++;
        stack[top] = x;
        printf("Pushed %d into the stack.\n", x);
    }
}

// POP operation
int pop() {
    if (isEmpty()) {
        printf("Stack Underflow! No elements to pop.\n");
        return -1;
    } else {
        int poppedElement = stack[top];
        top--;
        printf("Popped %d from the stack.\n", poppedElement);
        return poppedElement;
    }
}

// PEEK operation
int peek() {
    if (isEmpty()) {
        printf("Stack is empty! No top element.\n");
        return -1;
    } else {
        return stack[top];
    }
}

// DISPLAY operation
void display() {
    if (isEmpty()) {
        printf("Stack is empty!\n");
    } else {
        printf("Stack elements (bottom to top): ");
        for (int i = 0; i <= top; i++) {
            printf("%d ", stack[i]);
        }
        printf("\n");
    }
}

int main() {
    push(10);
    push(20);
    push(30);
    display();
    
    printf("Top element is: %d\n", peek());
    
    pop();
    display();
    
    return 0;
}
